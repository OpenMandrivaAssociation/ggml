From: Bernhard Rosenkränzer <bero@lindev.ch>
Subject: LLVM 23 CDNA1 MFMA bf16 builtins take short vectors

0.28 already passes short vectors to the RDNA3/RDNA4 WMMA bf16 builtins.
CDNA2 and later still match __bf16 for mfma_f32_16x16x16bf16_1k.
gfx908 (CDNA1) __builtin_amdgcn_mfma_f32_16x16x8bf16 wants a vector of
short, same bits as __bf16. ABF 684110/684111.

diff -up a/src/ggml-cuda/mma.cuh b/src/ggml-cuda/mma.cuh
--- a/src/ggml-cuda/mma.cuh
+++ b/src/ggml-cuda/mma.cuh
@@ -1437,7 +1437,8 @@ static __device__ __forceinline__ void mma(
 #elif defined(CDNA1)
 #pragma unroll
         for (int i = 0; i < 2; ++i) {
-            using bf16x2_t = __attribute__((ext_vector_type(2))) __bf16;
+            // LLVM 23: mfma_f32_16x16x8bf16 takes short, not __bf16.
+            using bf16x2_t = __attribute__((ext_vector_type(2))) short;
             const bf16x2_t& a_frag = reinterpret_cast<const bf16x2_t&>(A.x[i]);
             const bf16x2_t& b_frag = reinterpret_cast<const bf16x2_t&>(B.x[i]);
             acc_frag = __builtin_amdgcn_mfma_f32_16x16x8bf16(a_frag, b_frag, acc_frag, 0, 0, 0);
