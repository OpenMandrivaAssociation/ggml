 #undef NDEBUG
 #include <assert.h>
@@ -14,6 +15,39 @@
 #pragma warning(disable: 4244 4267) // possible loss of data
 #endif
 
+
+// With GGML_BACKEND_DL the CPU quantize API lives in the best libggml-cpu-*.so
+// plugin (loaded RTLD_LOCAL). Resolve it via the backend registry instead of
+// linking the symbols directly.
+using ggml_get_type_traits_cpu_t = const struct ggml_type_traits_cpu * (*)(enum ggml_type);
+using ggml_cpu_init_t = void (*)(void);
+
+static ggml_get_type_traits_cpu_t g_ggml_get_type_traits_cpu = nullptr;
+static ggml_cpu_init_t            g_ggml_cpu_init            = nullptr;
+
+static bool load_cpu_quantize_api(void) {
+#ifdef GGML_BACKEND_DL
+    ggml_backend_load_all();
+    ggml_backend_reg_t reg = ggml_backend_reg_by_name("CPU");
+    if (!reg) {
+        fprintf(stderr, "error: CPU backend not available (GGML_BACKEND_DL)\n");
+        return false;
+    }
+    g_ggml_get_type_traits_cpu = (ggml_get_type_traits_cpu_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_get_type_traits_cpu");
+    g_ggml_cpu_init = (ggml_cpu_init_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_cpu_init");
+    if (!g_ggml_get_type_traits_cpu || !g_ggml_cpu_init) {
+        fprintf(stderr, "error: CPU backend does not export quantize API\n");
+        return false;
+    }
+#else
+    g_ggml_get_type_traits_cpu = ::ggml_get_type_traits_cpu;
+    g_ggml_cpu_init = ::ggml_cpu_init;
+#endif
+    return true;
+}
