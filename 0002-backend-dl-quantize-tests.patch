--- a/tests/test-quantize-fns.cpp	2026-07-17 15:44:55.000000000 +0200
+++ b/tests/test-quantize-fns.cpp	2026-07-30 17:01:35.628464887 +0200
@@ -2,6 +2,7 @@
 
