+    // -o is otherwise applied only inside eval/eval_perf, so [i/N] counted
+    // skipped LIGHTNING_INDEXER cases too (N=1113). Drop them first.
+    auto filter_test_cases_by_op = [](std::vector<std::unique_ptr<test_case>> & test_cases, const char * op_names_filter) {
+        if (op_names_filter == nullptr) {
+            return;
+        }
+
+        ggml_init_params params = {
+            /* .mem_size = */ ggml_tensor_overhead()*128 + ggml_graph_overhead(),
+            /* .mem_base = */ NULL,
+            /* .no_alloc = */ true,
+        };
+
+        const size_t n_before = test_cases.size();
+        for (auto it = test_cases.begin(); it != test_cases.end();) {
+            ggml_context_ptr ctx(ggml_init(params));
+            if (!ctx) {
+                ++it;
+                continue;
+            }
+            ggml_context_ptr ctx_w((*it)->use_weight_context() ? ggml_init(params) : nullptr);
+            ggml_tensor * out = (*it)->build_graph(ctx.get(), ctx_w.get());
+            if (out && !(*it)->matches_filter(out, op_names_filter)) {
+                it = test_cases.erase(it);
+                continue;
+            }
+            ++it;
+        }
+        printf("filter -o: %zu -> %zu cases\n", n_before, test_cases.size());
+        fflush(stdout);
+    };
